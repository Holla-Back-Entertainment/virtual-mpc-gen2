 /* MIDI function driver setup/binding */
+
+/* string id of jack name idx in the attached table, 0 (none) when unnamed */
+static u8 f_midi_jack_string(struct f_midi *midi, struct usb_string *us, unsigned int idx)
+{
+	if (!midi->n_jack_strings || idx >= midi->n_jack_strings || !*midi->jack_strings[idx].s)
+		return 0;
+	return us[idx].id;
+}
+
+/* split the comma-separated names into the per-instance string table: [0] the function's own
+ * string, then one per in port, one per out port ("" = unnamed: iJack stays 0) */
+static void f_midi_split_jack_names(struct f_midi *midi)
+{
+	unsigned int n = 0, k, j;
+
+	if (!midi->jack_names[0] && !midi->jack_names[1])
+		return;	/* stock: no jack strings */
+	midi->jack_strings[n++].s = midi_string_defs[STRING_FUNC_IDX].s;
+	for (k = 0; k < 2; k++) {
+		char *p = midi->jack_names[k];
+
+		for (j = 0; j < (k ? midi->out_ports : midi->in_ports); j++) {
+			char *name = p ? strsep(&p, ",") : NULL;
+
+			midi->jack_strings[n++].s = name ? strim(name) : "";
+		}
+	}
+	midi->n_jack_strings = n;
+	midi->jack_stringtab.language = 0x0409;
+	midi->jack_stringtab.strings = midi->jack_strings;
+	midi->jack_stringtabs[0] = &midi->jack_stringtab;
+}
 

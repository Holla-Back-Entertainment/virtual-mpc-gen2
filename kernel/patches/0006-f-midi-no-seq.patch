f_midi: configfs option no_seq, no sequencer client for the gadget-side card (lab only).

Every rawmidi device gets an ALSA sequencer client, so a gadget's own end of its MIDI cables
("f_midi-0".."f_midi-N") shows up as MIDI ports next to the real ones. MPC hides the names
f_midi-0 and f_midi-1 but lists f_midi-2 and up. The lab's rear-MIDI gadget has 4 ports from the
app, so its far ends f_midi-2 and f_midi-3 appeared in the app's MIDI IN list. With no_seq=1 the
rawmidi has a dev_register op of its own, which makes the core skip the sequencer device; the
rawmidi itself (hw:<id>, used by the lab relay) is unchanged. Default 0 = stock behaviour.
Applies on top of 0005.
--- a/drivers/usb/gadget/function/f_midi.c
+++ b/drivers/usb/gadget/function/f_midi.c
@@ -94,6 +94,7 @@
 	int index;
 	char *id;
 	unsigned int buflen, qlen;
+	unsigned int no_seq;
 	/* This fifo is used as a buffer ring for pre-allocated IN usb_requests */
 	DECLARE_KFIFO_PTR(in_req_fifo, struct usb_request *);
 	spinlock_t transmit_lock;
@@ -793,7 +794,17 @@
 		snd_card_free(midi->card);
 		midi->card = NULL;
 	}
+}
+
+/* no_seq: a dev_register op of its own makes rawmidi skip its sequencer client */
+static int f_midi_noseq_register(struct snd_rawmidi *rmidi)
+{
+	return 0;
 }
+
+static const struct snd_rawmidi_global_ops f_midi_noseq_ops = {
+	.dev_register = f_midi_noseq_register,
+};
 
 /* register as a sound "card" */
 static int f_midi_register_card(struct f_midi *midi)
@@ -832,6 +843,8 @@
 		goto fail;
 	}
 	midi->rmidi = rmidi;
+	if (midi->no_seq)
+		rmidi->ops = &f_midi_noseq_ops;
 	midi->in_last_port = 0;
 	strcpy(rmidi->name, card->shortname);
 	rmidi->info_flags = SNDRV_RAWMIDI_INFO_OUTPUT |
@@ -1183,6 +1196,7 @@
 F_MIDI_OPT(qlen, false, 0);
 F_MIDI_OPT(in_ports, true, MAX_PORTS);
 F_MIDI_OPT(out_ports, true, MAX_PORTS);
+F_MIDI_OPT(no_seq, true, 1);
 
 static ssize_t f_midi_opts_id_show(struct config_item *item, char *page)
 {
@@ -1238,6 +1252,7 @@
 	&f_midi_opts_attr_qlen,
 	&f_midi_opts_attr_in_ports,
 	&f_midi_opts_attr_out_ports,
+	&f_midi_opts_attr_no_seq,
 	&f_midi_opts_attr_id,
 	NULL,
 };
@@ -1374,6 +1389,7 @@
 	midi->index = opts->index;
 	midi->buflen = opts->buflen;
 	midi->qlen = opts->qlen;
+	midi->no_seq = opts->no_seq;
 	midi->in_last_port = 0;
 	midi->free_ref = 1;
 

# Shell scripts run inside the Linux build container: keep LF even on Windows checkouts.
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.py text eol=lf
*.patch text eol=lf
initramfs/init text eol=lf
overlay/** text eol=lf
# Read or compiled inside the container or the VM too: kernel/lab.config with CRLF fails
# merge_config.sh's check ("MISSING: CONFIG_..."), so keep these LF as well.
kernel/*.config text eol=lf
*.c text eol=lf
*.h text eol=lf
inputs.sha256 text eol=lf
